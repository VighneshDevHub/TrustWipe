ENVIRONMENT=development

# Dev default: local SQLite, zero setup required.
# Production: postgresql+asyncpg://user:password@host:5432/trustwipe
DATABASE_URL=sqlite+aiosqlite:///./trustwipe.db

JWT_SECRET_KEY=change-me-in-production-use-a-real-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Leave blank in dev to auto-generate an ephemeral keypair at startup.
# In production, generate once with generate_keypair() in app/core/crypto.py
# and store these in your secrets manager, injected as env vars.
SIGNING_PRIVATE_KEY_PEM=
SIGNING_PUBLIC_KEY_PEM=

PUBLIC_BASE_URL=http://localhost:3000
