ENVIRONMENT=development

# Dev default: local SQLite, zero setup required.
# Production: postgresql+asyncpg://user:password@host:5432/trustwipe
DATABASE_URL=sqlite+aiosqlite:///./trustwipe.db

JWT_SECRET_KEY=change-me-in-production-use-a-real-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Leave blank in dev to auto-generate an ephemeral keypair at startup.
# In production, generate once with generate_keypair() in app/core/crypto.py
# and store these in your secrets manager, injected as env vars.
SIGNING_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgmHCHGBevkauluoLc\namQ4QX2RrmPKU/CLeFCoz5nUciOhRANCAASgW87xuiVl94qDhAVzxnbYzSCpR0pS\nCBrZrGQSXh7ruL7fkpjHXNCFaZEIfvwbWP2dUKes0rgByhysZAsAopBI\n-----END PRIVATE KEY-----\n

SIGNING_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEoFvO8bolZfeKg4QFc8Z22M0gqUdK\nUgga2axkEl4e67i+35KYx1zQhWmRCH78G1j9nVCnrNK4AcocrGQLAKKQSA==\n-----END PUBLIC KEY-----\n
PUBLIC_BASE_URL=http://localhost:3000
